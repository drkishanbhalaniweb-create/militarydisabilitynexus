# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only: Required for form submissions (API routes). Find at: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY

# Zoho Bookings Configuration (Free Discovery Call)
# Direct service link: https://militarydisabilitynexus.zohobookings.com/5013772000000040065
# Embed portal link: https://militarydisabilitynexus.zohobookings.com/portal-embed#/customer/5013772000000040065
NEXT_PUBLIC_ZOHO_BOOKINGS_URL_DISCOVERY=https://militarydisabilitynexus.zohobookings.com/5013772000000040065
# NEXT_PUBLIC_ZOHO_BOOKINGS_URL=https://militarydisabilitynexus.zohobookings.com/5013772000000040065

# Scheduler Configuration (Legacy fallback / Consultations)
NEXT_PUBLIC_ZOOM_URL=https://scheduler.zoom.us/kishan-bhalani/free-discovery-call
# Optional service-specific overrides (if distinct event types are used later):
# NEXT_PUBLIC_ZOOM_URL_CONSULTATION=YOUR_ZOOM_URL_CONSULTATION
