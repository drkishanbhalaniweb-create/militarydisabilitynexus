# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only: Required for form submissions (API routes). Find at: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY

# Zoom Scheduler Configuration (Universal booking link)
NEXT_PUBLIC_ZOOM_URL=YOUR_ZOOM_SCHEDULER_URL
# Optional service-specific overrides (if distinct event types are used later):
# NEXT_PUBLIC_ZOOM_URL_DISCOVERY=YOUR_ZOOM_URL_DISCOVERY
# NEXT_PUBLIC_ZOOM_URL_CONSULTATION=YOUR_ZOOM_URL_CONSULTATION
# NEXT_PUBLIC_ZOOM_URL_CP_COACHING=YOUR_ZOOM_URL_CP_COACHING

# Optional: Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=YOUR_META_PIXEL_ID

# Optional: Visual Edits (for development)
NEXT_PUBLIC_ENABLE_VISUAL_EDITS=true
NEXT_PUBLIC_ENABLE_HEALTH_CHECK=false
